// nextflow.config

// ─────────────────────────────────────────────
//  Execution profiles
// ─────────────────────────────────────────────
profiles {

    // Run locally (e.g., for testing)
    local {
        process.executor = 'local'
        conda.enabled    = true
    }

    // Run on SLURM cluster
    slurm {
        process.executor = 'slurm'
        conda.enabled    = true

        // Default resource limits (overridden per-process below)
        process {
            queue      = 'main'
            memory     = '8 GB'
            cpus       = 4
            time       = '4h'

            // ── Per-process overrides ───────────────────────
            withName: 'REMOVE_DUPLICATES' {
                memory = '4 GB'
                cpus   = 2
                time   = '1h'
            }
            withName: 'EXTRACT_UNIPROT_IDS' {
                memory = '2 GB'
                cpus   = 1
                time   = '30m'
            }
            withName: 'QUERY_AFDB_API' {
                memory = '4 GB'
                cpus   = 1
                time   = '4h'   // API queries can be slow for large sets
            }
            withName: 'FILTER_LENGTH_PLDDT' {
                memory = '4 GB'
                cpus   = 1
                time   = '30m'
            }
            withName: 'MMSEQS_CLUSTER' {
                memory = '10 GB'
                cpus   = 8
                time   = '12h'
            }
            withName: 'FILTER_METADATA_REPR' {
                memory = '4 GB'
                cpus   = 1
                time   = '30m'
            }
            withName: 'DOWNLOAD_PDB_STRUCTURES' {
                memory = '8 GB'
                cpus   = 2
                time   = '6h'
            }
            withName: 'PARSE_PDB_TO_PT' {
                memory = '8 GB'
                cpus   = 1
                time   = '1h'
            }
            withName: 'CREATE_CLUSTER_LIST' {
                memory = '2 GB'
                cpus   = 1
                time   = '15m'
            }
            withName: 'CREATE_CLUSTER_LISTS_PY' {
                memory = '8 GB'
                cpus   = 1
                time   = '1h'
            }
            withName: 'MPNN_RETRAIN' {
                queue          = 'gpu'
                memory         = '10 GB'
                cpus           = 8
                time           = '72h'
                clusterOptions = '--gres=gpu:1 --requeue --export=ALL --nodes=1 --ntasks=8 --cpus-per-task=1'
            }
        }
    }
}


// ─────────────────────────────────────────────
//  Default parameters (can be overridden on CLI)
// ─────────────────────────────────────────────
params {
    input_fasta              = null
    datadir                  = "/projects/f_sdk94_1/all239/HaloMPNN_data"
    outdir                   = "results"
    seqid                    = 0.20
    split_memory_limit       = "10G"
    min_length               = 50
    min_plddt                = 80
    num_neighbors            = 48
    backbone_noise           = 0.20
    num_epochs               = 300
    batch_size               = 3000
    max_protein_length       = 5000
    num_examples_per_epoch   = 1000
    mmseqs_conda             = "/projects/f_sdk94_1/conda/envs/mmseqs"
    aifold_conda             = "/projects/f_sdk94_1/conda/envs/aifold"
    scripts_dir              = "${projectDir}/bin"
}


// ─────────────────────────────────────────────
//  Global settings
// ─────────────────────────────────────────────
conda {
    enabled     = true
    useMamba    = true   // set true if mamba is available for faster solves
    cacheDir    = "${HOME}/.nextflow/conda"
}

// Work directory for intermediate files
workDir = 'work'

// Output report / trace / timeline
report {
    enabled = true
    file    = "${params.outdir}/reports/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/reports/trace.txt"
    fields  = 'task_id,name,status,exit,realtime,cpus,memory,rss,vmem'
    overwrite = true
}
timeline {
    enabled = true
    file    = "${params.outdir}/reports/timeline.html"
    overwrite = true
}
